{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>TotallyNotRobots/renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["**/*.toml"],
      "description": "Pinned python packages in style data",
      "matchStrings": [
        "(?<depName>[\\d\\w\\-\\._\\[\\]]+)==(?<currentValue>[\\d\\w\\-\\.]+).* # renovate: datasource=(?<datasource>pypi)"
      ]
    }
  ]
}
